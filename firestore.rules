rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // المشرف = مستخدم له مستند في admins/{uid} (يُنشأ يدويًا من لوحة Firebase فقط)
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // إعدادات التطبيق (حساب المصرف والباقات): قراءة للجميع، كتابة للمشرف
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // الاشتراك: المستخدم يقرأ اشتراكه فقط، ولا أحد يكتبه إلا المشرف
    match /entitlements/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // طلبات الشحن
    match /requests/{ref} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.ref == ref
        && ref.matches('LD-[A-Z0-9]{6}')
        && request.resource.data.keys().hasOnly(
             ['uid','email','planId','planName','days','price','ref','status','receiptHash','createdAt'])
        // الإيصال والبصمة يُرسلان في نفس العملية
        && existsAfter(/databases/$(database)/documents/receipts/$(ref))
        && existsAfter(/databases/$(database)/documents/receiptHashes/$(request.resource.data.receiptHash));
      allow update, delete: if isAdmin();
    }

    // صور الإيصالات (يقرؤها المشرف فقط)
    match /receipts/{ref} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','data','createdAt'])
        && request.resource.data.data.size() < 600000
        && getAfter(/databases/$(database)/documents/requests/$(ref)).data.uid == request.auth.uid;
      allow read, delete: if isAdmin();
    }

    // بصمات الإيصالات: إنشاء فقط. إن كان المستند موجودًا يصبح الإنشاء "تحديثًا" فيُرفض
    // ويفشل الطلب كله، وهذا يمنع استخدام نفس صورة الإيصال مرتين.
    match /receiptHashes/{h} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && h.matches('[a-f0-9]{64}');
      allow read, delete: if isAdmin();
    }
    // ملف المستخدم: يُنشأ مرة واحدة عند أول دخول. trial=true (تجربة 7 أيام) لا يُقبل إلا
    // مع ربط الهاتف devices/{hash} في نفس العملية، فلا يحصل هاتف على تجربة ثانية.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['createdAt','deviceHash','trial'])
        && request.resource.data.createdAt == request.time
        && (
          request.resource.data.trial == false
          || (
            request.resource.data.trial == true
            && request.resource.data.deviceHash.matches('[a-f0-9]{64}')
            && existsAfter(/databases/$(database)/documents/devices/$(request.resource.data.deviceHash))
            && getAfter(/databases/$(database)/documents/devices/$(request.resource.data.deviceHash)).data.uid == uid
          )
        );
      allow update, delete: if isAdmin();
    }

    // أجهزة العائلة: كل مستند هاتف ابن يملكه صاحب الحساب وحده (يقرؤه ويكتبه ويحذفه)
    match /families/{uid}/kids/{kid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && kid.matches('[a-f0-9]{16}')
        && request.resource.data.keys().hasOnly(['name','model','on','ver','seen','sleepOn','sleepStart','sleepEnd','paused','total','blocked','top','topDay'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && (!('top' in request.resource.data) || (request.resource.data.top is list && request.resource.data.top.size() <= 10));
    }

    // بصمة الهاتف (SHA-256، لا يخرج المعرّف الأصلي): إنشاء فقط، فإن وُجد المستند يُرفض الإنشاء الثاني.
    match /devices/{h} {
      // قراءة مستند واحد فقط (يحتاجها التطبيق للتحقق من هاتفه)، أما سرد كل الأجهزة فللمشرف وحده
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create: if signedIn() && h.matches('[a-f0-9]{64}')
        && request.resource.data.keys().hasOnly(['uid','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid));
      allow update, delete: if isAdmin();
    }
  }
}
